{
  "batch": "slb_smoke",
  "init_commands": [
    "no slb group method \"g_web1\"",
    "no slb group method \"g_web2\""
  ],
  "cases": [
    {
      "autoid": "202609236681010001",
      "priority": "P1",
      "description": "SLB服务组成员配置下发与回显校验",
      "steps": [
        {"e": "APV_0", "f": "cmd_config", "g": "slb real http \"r_web1\" 10.1.1.11 80", "h": "", "i": "", "desc": "创建真实服务1"},
        {"e": "APV_0", "f": "cmd_config", "g": "slb real http \"r_web2\" 10.1.1.12 80", "h": "", "i": "", "desc": "创建真实服务2"},
        {"e": "APV_0", "f": "cmd_config", "g": "slb group method \"g_web1\" rr", "h": "", "i": "", "desc": "创建轮询服务组"},
        {"e": "APV_0", "f": "cmd_config", "g": "slb group member \"g_web1\" \"r_web1\"", "h": "", "i": "", "desc": "添加成员1"},
        {"e": "APV_0", "f": "cmd_config", "g": "slb group member \"g_web1\" \"r_web2\"", "h": "", "i": "", "desc": "添加成员2"},
        {"e": "APV_0", "f": "cmd_config", "g": "show slb group member g_web1", "h": "", "i": "", "desc": "回显成员表"},
        {"e": "check_point", "f": "found", "g": "r_web1", "h": "", "i": "", "desc": "断言成员1在回显中",
         "source": {"kind": "configbinding", "ref": "step:4"}},
        {"e": "check_point", "f": "found_times", "g": "r_web[12]", "h": "", "i": "2", "desc": "断言两个成员各出现一次",
         "source": {"kind": "configbinding", "ref": "step:4-5"}},
        {"e": "APV_0", "f": "cmds_config", "g": "no slb group member \"g_web1\" \"r_web1\"\nno slb group member \"g_web1\" \"r_web2\"\nno slb group method \"g_web1\"\nno slb real http \"r_web1\"\nno slb real http \"r_web2\"", "h": "", "i": "", "desc": "收尾：删掉本案建的对象"}
      ]
    },
    {
      "autoid": "202609236681020001",
      "priority": "P2",
      "description": "SLB服务组删除后回显不再出现",
      "steps": [
        {"e": "APV_0", "f": "cmd_config", "g": "slb group method \"g_web2\" rr", "h": "", "i": "", "desc": "创建服务组"},
        {"e": "APV_0", "f": "cmd_config", "g": "show slb group method", "h": "", "i": "", "desc": "回显服务组"},
        {"e": "check_point", "f": "found", "g": "g_web2", "h": "", "i": "", "desc": "断言服务组已创建",
         "source": {"kind": "configbinding", "ref": "step:1"}},
        {"e": "APV_0", "f": "cmd_config", "g": "no slb group method \"g_web2\"", "h": "", "i": "", "desc": "删除服务组"},
        {"e": "APV_0", "f": "cmd_config", "g": "show slb group method", "h": "", "i": "", "desc": "再次回显服务组"},
        {"e": "check_point", "f": "not_found", "g": "g_web2", "h": "", "i": "", "desc": "断言服务组已删除",
         "source": {"kind": "configbinding", "ref": "step:4"}}
      ]
    }
  ]
}
