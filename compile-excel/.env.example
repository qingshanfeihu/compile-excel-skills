# compile-excel 环境绑定模板
# 用法：cp .env.example ~/.config/compile-excel/env 后按本机实际填写
# 或由 Setup 向导调用 scripts/bind_env.sh 写入（机密项请人工填写，勿经对话传输）

# KMS 服务地址（必填，host:port）
KMS_ADDR=

# 跳转机（必填，IP 或域名）
JUMPHOST_IP=
# 跳转机登录用户与端口（可选，默认当前用户/22）
JUMPHOST_USER=
JUMPHOST_PORT=22

# 本地知识库目录（可选）：放 cmdtree*.xml（命令树）与手册/规格 *.md。
# 有它时：cmdtree_check 用真树做编译期命令 grounding；
# recompose 把 *.md 当作合法逐字来源（origin spec:<file>:<line>）。
KNOWLEDGE_DIR=
