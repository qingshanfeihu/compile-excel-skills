#!/usr/bin/env python3
"""cex_tool：命令行调用 compile-excel 工具（pi 扩展与人工调试用）。

  cex_tool list                      列出工具与参数 schema
  cex_tool <工具名> -                 参数（JSON）从 stdin 读：适配器都走这个，大参数不受
                                     命令行长度限制（Linux 单个参数上限 128 KiB）
  cex_tool <工具名> ['<JSON 参数>']    调用工具，结果以 JSON 打印到 stdout
  cex_tool <工具名> --args-file F     参数从文件读（避免参数进 shell 历史）

退出码：0 成功；1 工具返回失败；2 用法错误。
"""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from cex_client import tools  # noqa: E402


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 2
    if argv[0] == "list":
        print(json.dumps(tools.load_specs(), ensure_ascii=False, indent=1))
        return 0
    name, rest = argv[0], argv[1:]
    try:
        if rest[:1] == ["--args-file"] and len(rest) == 2:
            args = json.loads(Path(rest[1]).read_text(encoding="utf-8"))
        elif rest == ["-"]:
            args = json.loads(sys.stdin.buffer.read().decode("utf-8") or "{}")
        elif len(rest) == 1:
            args = json.loads(rest[0])
        elif not rest:
            args = {}
        else:
            print("usage: cex_tool <name> - | ['<json>'] | --args-file F", file=sys.stderr)
            return 2
    except (OSError, ValueError) as exc:
        print(json.dumps({"ok": False, "error": f"bad arguments: {exc}"}))
        return 2
    result = tools.call(name, args)
    print(json.dumps(result, ensure_ascii=False, indent=1))
    return 0 if result.get("ok", True) is not False or result.get("pending") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
